<Page x:Class="Akhmetgareev41.AddEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Akhmetgareev41"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddEditPage" FontFamily="Comic Sans MS">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="240"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Артикул"
                       VerticalAlignment="Center"></TextBlock>
            <TextBox Grid.Row="0" Grid.Column="1" Name="ArticleTB"
                     Height="28" Margin="0,4" VerticalContentAlignment="Center"></TextBox>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Название"
                       VerticalAlignment="Center"></TextBlock>
            <TextBox Grid.Row="1" Grid.Column="1" Name="NameTB"
                     Height="28" Margin="0,4" VerticalContentAlignment="Center"></TextBox>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Единица измерения"
                       VerticalAlignment="Center"></TextBlock>
            <TextBox Grid.Row="2" Grid.Column="1" Name="UnitTB"
                     Height="28" Margin="0,4" VerticalContentAlignment="Center"></TextBox>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Цена"
                       VerticalAlignment="Center"></TextBlock>
            <TextBox Grid.Row="3" Grid.Column="1" Name="CostTB"
                     Height="28" Margin="0,4" VerticalContentAlignment="Center"></TextBox>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Макс. скидка, %"
                       VerticalAlignment="Center"></TextBlock>
            <TextBox Grid.Row="4" Grid.Column="1" Name="MaxDiscountTB"
                     Height="28" Margin="0,4" VerticalContentAlignment="Center"></TextBox>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Производитель"
                       VerticalAlignment="Center"></TextBlock>
            <TextBox Grid.Row="5" Grid.Column="1" Name="ManufacturerTB"
                     Height="28" Margin="0,4" VerticalContentAlignment="Center"></TextBox>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Поставщик"
                       VerticalAlignment="Center"></TextBlock>
            <TextBox Grid.Row="6" Grid.Column="1" Name="SupplierTB"
                     Height="28" Margin="0,4" VerticalContentAlignment="Center"></TextBox>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Категория"
                       VerticalAlignment="Center"></TextBlock>
            <TextBox Grid.Row="7" Grid.Column="1" Name="CategoryTB"
                     Height="28" Margin="0,4" VerticalContentAlignment="Center"></TextBox>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Скидка, %"
                       VerticalAlignment="Center"></TextBlock>
            <TextBox Grid.Row="8" Grid.Column="1" Name="DiscountTB"
                     Height="28" Margin="0,4" VerticalContentAlignment="Center"></TextBox>

            <TextBlock Grid.Row="9" Grid.Column="0" Text="Количество"
                       VerticalAlignment="Center"></TextBlock>
            <TextBox Grid.Row="9" Grid.Column="1" Name="QuantityTB"
                     Height="28" Margin="0,4" VerticalContentAlignment="Center"></TextBox>

            <TextBlock Grid.Row="10" Grid.Column="0" Text="Описание"
                       VerticalAlignment="Top" Margin="0,8,0,0"></TextBlock>
            <TextBox Grid.Row="10" Grid.Column="1" Name="DescriptionTB"
                     Height="70" Margin="0,4" TextWrapping="Wrap"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"></TextBox>

            <TextBlock Grid.Row="11" Grid.Column="0" Text="Фото"
                       VerticalAlignment="Center"></TextBlock>
            <TextBox Grid.Row="11" Grid.Column="1" Name="PhotoTB"
                     Height="28" Margin="0,4" IsReadOnly="True"
                     VerticalContentAlignment="Center"></TextBox>
            <Button Grid.Row="11" Grid.Column="2" Name="SelectPhotoBtn"
                    Content="Выбрать фото" Click="SelectPhotoBtn_Click"
                    Width="150" Height="30"></Button>

            <Image Grid.Row="0" Grid.Column="2" Grid.RowSpan="11"
                   Name="PhotoImage" Width="220" Height="220"
                   Stretch="Uniform" Margin="10"></Image>

            <StackPanel Grid.Row="12" Grid.Column="1"
                        Orientation="Horizontal" Margin="0,15,0,0">
                <Button Content="Сохранить" Click="SaveBtn_Click" Width="150"></Button>
                <Button Content="Отмена" Click="CancelBtn_Click" Width="150"></Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
