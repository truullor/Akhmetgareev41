<Page x:Class="Akhmetgareev41.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Akhmetgareev41"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="120"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="180"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right">
            <TextBlock Name="Login" Text="Логин" FontSize="24"></TextBlock>
            <TextBlock Name="Password" Text="Пароль" FontSize="24"></TextBlock>            
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
            <TextBox Name="UserLogin" VerticalAlignment="Center" Margin="5" Height="30" Width="200"></TextBox>
            <PasswordBox Name="UserPassword" VerticalAlignment="Center" Margin="5" Height="30" Width="200"></PasswordBox>
        </StackPanel>
        <StackPanel Name="CaptchaPanel" Grid.Row="1" Grid.Column="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Name="captchaOneWord" FontSize="22" Margin="30,0,0,0"></TextBlock>
                <TextBlock Name="captchaTwoWord" FontSize="22" TextDecorations="Strikethrough" Margin="20,0,0,0"></TextBlock>
                <TextBlock Name="captchaThreeWord" FontSize="22" TextDecorations="Strikethrough" Margin="10,0,0,0"></TextBlock>
                <TextBlock Name="captchaFourWord" FontSize="22" TextDecorations="Strikethrough" Margin="5,0,0,0"></TextBlock>
            </StackPanel>
            <TextBox Name="CaptchaInput" Width="170" Height="30" Margin="0,5,0,0"
                     HorizontalAlignment="Center"></TextBox>
        </StackPanel>
        <Button Name="GuestBtn" Content="Войти как гость" Grid.Row="2" Grid.Column="0" Click="GuestBtn_Click"></Button>
        <Button Name="LoginBtn" Content="Войти" Grid.Row="2" Grid.Column="2" Click="LoginBtn_Click"></Button>
    </Grid>
</Page>
