<Page x:Class="Akhmetgareev41.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Akhmetgareev41"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage" FontFamily="Comic Sans MS" Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Margin="10" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5"
                        Orientation="Vertical" HorizontalAlignment="Right" Margin="0,0,0,5">
                <TextBlock Name="FIOTB" FontSize="14" TextAlignment="Right"></TextBlock>
                <TextBlock Name="RoleTB" FontSize="14" TextAlignment="Right"></TextBlock>
            </StackPanel>

            <Button Name="AddProductBtn" Grid.Row="0" Grid.Column="0"
                    Content="Добавить товар" Click="AddProductBtn_Click"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Visibility="Collapsed"></Button>

            <TextBlock Name="TBlockCount" Grid.Row="1" Text="кол-во 0 из 0" FontSize="14"
                       VerticalAlignment="Center" Margin="0,0,20,0"></TextBlock>

            <TextBlock Grid.Row="1" Grid.Column="1" Text="поиск по наименованию" FontSize="14"
                       VerticalAlignment="Center" Margin="0,0,5,0"></TextBlock>

            <TextBox Name="TBoxSearch" Grid.Row="1" Grid.Column="2" TextChanged="TBoxSearch_TextChanged"
                     FontSize="14" VerticalAlignment="Center" Margin="0,0,20,0"></TextBox>

            <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,20,0">
                <RadioButton Content="по возрастанию стоимости" GroupName="Sort"
                             FontSize="14" Checked="RButtonUp_Checked" Name="RButtonUp"></RadioButton>
                <RadioButton Content="по убыванию стоимости" GroupName="Sort"
                             FontSize="14" Checked="RButtonDown_Checked" Name="RButtonDown"></RadioButton>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Vertical" VerticalAlignment="Center">
                <TextBlock Text="фильтрация по скидке" FontSize="14" Margin="0,0,0,2"></TextBlock>
                <ComboBox Name="ComboType" SelectionChanged="ComboType_SelectionChanged"
                          FontSize="14" MinWidth="180">
                    <TextBlock>Все</TextBlock>
                    <TextBlock>от 0 до 9,99%</TextBlock>
                    <TextBlock>от 10 до 14,99%</TextBlock>
                    <TextBlock>от 15% и более</TextBlock>
                </ComboBox>
            </StackPanel>
        </Grid>

        <ListView Name="ProductListView" Grid.Row="1" HorizontalContentAlignment="Stretch"
                  MouseDoubleClick="ProductListView_MouseDoubleClick">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Добавить к заказу" Click="MenuItem_Click"></MenuItem>
                    <MenuItem Header="Редактировать" Click="EditMenuItem_Click"></MenuItem>
                    <MenuItem Header="Удалить" Click="DeleteMenuItem_Click"></MenuItem>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.ItemTemplate>
                <DataTemplate>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                           
                            <ColumnDefinition Width="120"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="100"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            
                        </Grid.RowDefinitions>

                        <Image Width="120" Height="100" Grid.Column="0" Grid.Row="0" Grid.RowSpan="4" Stretch="Fill">
                            <Image.Source>
                                <Binding Path="ProductImageFull">
                                    <Binding.TargetNullValue>
                                        <ImageSource>
                                            /img/picture.png

                                        </ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <TextBlock Text="{Binding ProductName}" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" FontSize="20"></TextBlock>
                        <TextBlock Text="{Binding ProductDescription}" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" FontSize="14" TextWrapping="Wrap"></TextBlock>
                        <TextBlock Text="{Binding ProductManufacturer}" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left" FontSize="20"></TextBlock>
                        <TextBlock Text="{Binding ProductCost, StringFormat={}{0} руб.}" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Left" FontSize="16"></TextBlock>
                        <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="4"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Скидка" HorizontalAlignment="Center" FontSize="14"></TextBlock>
                            <TextBlock Text="{Binding ProductDiscountAmount, StringFormat={}{0}%}"
                                       HorizontalAlignment="Center" FontSize="24"></TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>